# Backend Environment Variables
# Copy this file to .env and update with your values

# Database Configuration (AWS RDS Simulation)
DB_HOST=mysql
DB_NAME=pid_evaluation
DB_USER=pid_user
DB_PASSWORD=pid_password

# AWS Configuration (LocalStack Simulation)
AWS_ENDPOINT=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# YII2 Configuration
YII_DEBUG=true
YII_ENV=dev
# IMPORTANT: Generate a secure random string for production
# Example: openssl rand -base64 32
COOKIE_VALIDATION_KEY=dev-key-only-change-for-production

# Application Settings
APP_NAME="PID Employee Evaluation System"
