{
    "name": "pid/evaluation-employee-backend",
    "description": "PID Employee Evaluation System - YII2 Admin Backend",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "yiisoft/yii2": "~2.0.45",
        "yiisoft/yii2-bootstrap5": "~2.0.2",
        "aws/aws-sdk-php": "^3.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    },
    "config": {
        "process-timeout": 1800,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-functional": "phpunit --testsuite functional",
        "test-unit": "phpunit --testsuite unit",
        "test-acceptance": "phpunit --testsuite acceptance"
    }
}
